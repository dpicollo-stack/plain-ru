+// Fork: font settings.
+
+import { describe, expect, it } from "vitest";
+import { isCustomFamily, MONO, normalizeTextFont, SANS, SERIF, textFontStack } from "./fonts";
+import { DEFAULTS, parseSettings, serializeSettings } from "./settings";
+
+describe("text font", () => {
+  it("maps presets to stacks", () => {
+    expect(textFontStack("sans")).toBe(SANS);
+    expect(textFontStack("serif")).toBe(SERIF);
+    expect(textFontStack("mono")).toBe(MONO);
+  });
+
+  it("puts an installed family in front of the sans stack", () => {
+    expect(textFontStack("PT Serif")).toBe(`"PT Serif", ${SANS}`);
+    expect(textFontStack("Шрифт Тест-2")).toBe(`"Шрифт Тест-2", ${SANS}`);
+  });
+
+  it("refuses anything that could leave the CSS declaration", () => {
+    for (const bad of ['x", serif; } body { display:none', "a;b", "a{b", "a,b", "a'b", "a\\b", "a/*b", ""]) {
+      expect(isCustomFamily(bad)).toBe(false);
+      expect(normalizeTextFont(bad, "sans")).toBe("sans");
+      expect(textFontStack(bad)).toBe(SANS);
+    }
+    expect(normalizeTextFont("x".repeat(65), "sans")).toBe("sans");
+  });
+
+  it("collapses inner spaces", () => {
+    expect(normalizeTextFont("  PT   Serif ", "sans")).toBe("PT Serif");
+  });
+});
+
+describe("settings.json, fork keys", () => {
+  it("defaults to Russian and the system fonts", () => {
+    expect(DEFAULTS.appearance).toMatchObject({
+      language: "ru",
+      uiFont: "system",
+      textFont: "sans",
+      editFont: "mono",
+      uiSize: 14,
+      fontSize: 15,
+    });
+  });
+
+  it("clamps and falls back value by value", () => {
+    const { settings } = parseSettings(
+      JSON.stringify({
+        appearance: { language: "de", uiFont: "comic", textFont: "a;b", editFont: "text", uiSize: 40 },
+      }),
+    );
+    expect(settings.appearance.language).toBe("ru");
+    expect(settings.appearance.uiFont).toBe("system");
+    expect(settings.appearance.textFont).toBe("sans");
+    expect(settings.appearance.editFont).toBe("text");
+    expect(settings.appearance.uiSize).toBe(18);
+  });
+
+  it("reads a file written by upstream Plain, which has none of the keys", () => {
+    const { settings, invalid } = parseSettings(
+      '{ "appearance": { "theme": "dark", "fontSize": 13.5, "contentWidth": 560 } }',
+    );
+    expect(invalid).toBe(false);
+    expect(settings.appearance.theme).toBe("dark");
+    expect(settings.appearance.fontSize).toBe(13.5);
+    expect(settings.appearance.language).toBe("ru");
+  });
+
+  it("writes the fork keys", () => {
+    const text = serializeSettings(DEFAULTS);
+    for (const key of ["language", "uiFont", "textFont", "editFont", "uiSize"]) {
+      expect(text).toContain(`"${key}"`);
+    }
+  });
+});
