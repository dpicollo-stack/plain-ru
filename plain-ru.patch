+#!/bin/bash
+# Plain RU: сборка .dmg на своём Mac одной командой.
+# Нужны: Xcode Command Line Tools, Node.js 22, Rust (rustup).
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+for tool in node npm cargo rustup; do
+  command -v "$tool" >/dev/null || { echo "Не найден $tool — см. FORK_RU.md, раздел «Сборка»."; exit 1; }
+done
+
+rustup target add aarch64-apple-darwin x86_64-apple-darwin
+npm ci
+npx vitest run
+(cd src-tauri && cargo test)
+# Подпись ad-hoc, как в CI оригинала без сертификата Apple.
+APPLE_SIGNING_IDENTITY=- npx tauri build --target universal-apple-darwin --bundles app dmg
+
+echo
+echo "Готово:"
+ls -1 src-tauri/target/universal-apple-darwin/release/bundle/dmg/*.dmg
