+<!-- Fork (Plain RU): Tauri merges this into the bundle's Info.plist. It tells
+     macOS the app speaks Russian, so the system's own panels — open, save,
+     print, the Services menu — follow the user's language instead of
+     falling back to English. -->
+<plist version="1.0">
+<dict>
+  <key>CFBundleDevelopmentRegion</key>
+  <string>ru</string>
+  <key>CFBundleLocalizations</key>
+  <array>
+    <string>ru</string>
+    <string>en</string>
+  </array>
+  <key>CFBundleAllowMixedLocalizations</key>
+  <true/>
+</dict>
+</plist>
