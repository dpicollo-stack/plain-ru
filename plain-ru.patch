@@ -0,0 +1,9 @@
+/** Russian plural: 1 файл, 2 файла, 5 файлов. Takes `1,204` as well as 1204. */
+export function plural(n: number | string, one: string, few: string, many: string): string {
+  const value = Math.abs(Math.trunc(Number(String(n).replace(/[^\d.-]/g, ""))));
+  const ten = value % 10;
+  const hundred = value % 100;
+  if (ten === 1 && hundred !== 11) return one;
+  if (ten >= 2 && ten <= 4 && (hundred < 12 || hundred > 14)) return few;
+  return many;
+}
