+    pub cut: Option<&'static str>,
+    pub copy: Option<&'static str>,
+    pub paste: Option<&'static str>,
+    pub select_all: Option<&'static str>,
+    pub window: &'static str,
+    pub minimize: Option<&'static str>,
+    pub maximize: Option<&'static str>,
+}
+
+impl MenuWords {
+    pub fn for_language(language: &str) -> Self {
+        if language == "en" {
+            return MenuWords {
+                quit: "Quit Plain",
+                about: None,
+                services: None,
+                hide: None,
+                hide_others: None,
+                show_all: None,
+                edit: "Edit",
+                undo: None,
+                redo: None,
+                cut: None,
+                copy: None,
+                paste: None,
+                select_all: None,
+                window: "Window",
+                minimize: None,
+                maximize: None,
+            };
+        }
+        // The titles a Russian macOS uses in its own apps.
+        MenuWords {
+            quit: "Завершить Plain",
+            about: Some("О программе Plain"),
+            services: Some("Службы"),
+            hide: Some("Скрыть Plain"),
+            hide_others: Some("Скрыть остальные"),
+            show_all: Some("Показать все"),
+            edit: "Правка",
+            undo: Some("Отменить"),
