+// Fork: interface and text fonts (Plain RU).
+//
+// Upstream draws everything in one monospace face. The fork keeps that face
+// for code and offers the system fonts for the interface and the text. Only
+// fonts already installed on the machine are used — nothing is downloaded,
+// and the CSP does not have to change: a font-family name is not a request.
+
+export type UiFont = "system" | "mono";
+export type EditFont = "mono" | "text";
+export type TextPreset = "sans" | "serif" | "mono";
+
+export const UI_FONTS: readonly UiFont[] = ["system", "mono"] as const;
+export const EDIT_FONTS: readonly EditFont[] = ["mono", "text"] as const;
+export const TEXT_PRESETS: readonly TextPreset[] = ["sans", "serif", "mono"] as const;
+
+/**
+ * SF Pro on macOS, Segoe UI on Windows; both carry Cyrillic. `-apple-system`
+ * is what WKWebView understands, `system-ui` covers the rest.
+ */
+export const SANS =
+  '-apple-system, BlinkMacSystemFont, system-ui, "Segoe UI Variable Text", "Segoe UI", "Helvetica Neue", Arial, sans-serif';
+
+/**
+ * New York through `ui-serif` in WKWebView; PT Serif ships with macOS and is
+ * a good Cyrillic serif; Georgia is the Windows fallback.
+ */
+export const SERIF = 'ui-serif, "New York", "PT Serif", Georgia, "Times New Roman", serif';
+
+/** The upstream face, still bundled. */
+export const MONO = '"IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace';
+
+/** Bounds for `appearance.uiSize`, in px; upstream draws the UI at 13. */
+export const UI_SIZE = { min: 11, max: 18, step: 0.5 } as const;
+
+/** The size the UI tokens in tokens.css were drawn for. */
+export const UI_BASE = 13;
+
+/**
+ * A family installed on the machine, typed by hand: letters of any script,
+ * digits, spaces, dots, hyphens and underscores. Quotes, commas, semicolons
+ * and braces are refused, so the value can never break out of the CSS
+ * declaration it lands in.
+ */
+const FAMILY = /^[\p{L}\p{N} ._-]{1,64}$/u;
+
+export function isCustomFamily(value: string): boolean {
+  const trimmed = value.trim();
+  return trimmed.length > 0 && FAMILY.test(trimmed) && !TEXT_PRESETS.includes(trimmed as TextPreset);
+}
+
+/** Normalizes `appearance.textFont`: a preset, a valid family name, or the fallback. */
+export function normalizeTextFont(value: unknown, fallback: string): string {
+  if (typeof value !== "string") return fallback;
+  const trimmed = value.trim();
+  if (TEXT_PRESETS.includes(trimmed as TextPreset)) return trimmed;
+  return isCustomFamily(trimmed) ? trimmed.replace(/\s+/g, " ") : fallback;
+}
+
+/** The CSS stack for a text font: a preset, or a family with the sans stack behind it. */
+export function textFontStack(value: string): string {
+  if (value === "serif") return SERIF;
+  if (value === "mono") return MONO;
+  if (value === "sans" || !isCustomFamily(value)) return SANS;
+  return `"${value.trim()}", ${SANS}`;
+}
+
+export function uiFontStack(value: UiFont): string {
+  return value === "mono" ? MONO : SANS;
+}
