@@ -0,0 +1,175 @@
+// Fork: the Russian interface. These tests unpin the language that
+// vitest.setup.ts pins to English for the upstream suite.
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { commands } from "../app/registry";
+import { menuModel, type MenuNode } from "../app/menu";
+import { hasTranslation, months, plural, setLanguage, setLanguageForTests, t, tc } from ".";
+
+beforeEach(() => {
+  setLanguageForTests(null);
+  setLanguage("ru");
+});
+
+afterEach(() => setLanguageForTests("en"));
+
+describe("plural", () => {
+  it.each([
+    [1, "файл"],
+    [2, "файла"],
+    [5, "файлов"],
+    [11, "файлов"],
+    [21, "файл"],
+    [22, "файла"],
+    [112, "файлов"],
+    ["1,204", "файла"],
+  ])("%s → %s", (n, form) => {
+    expect(plural(n, "файл", "файла", "файлов")).toBe(form);
+  });
+});
+
+describe("t", () => {
+  it("translates exact text and leaves unknown text alone", () => {
+    expect(t("save as…")).toBe("Сохранить как…");
+    expect(t("my notes.md")).toBe("my notes.md");
+  });
+
+  it("fills placeholders and translates nested pieces in lower case", () => {
+    expect(t("couldn't save — file changed on disk")).toBe(
+      "Не удалось сохранить — файл изменился на диске",
+    );
+    expect(t("close notes.md first")).toBe("Сначала закройте «notes.md»");
+  });
+
+  it("uses Russian plurals", () => {
+    expect(t("1,204 words")).toBe("1,204 слова");
+    expect(t("5 files")).toBe("5 файлов");
+    expect(t("3 lines in 1 file")).toBe("3 строки в 1 файле");
+    expect(t("2 of 7 differences")).toBe("2 из 7 различий");
+  });
+
+  it("prefers the longer literal over a generic pattern", () => {
+    expect(t("couldn't open settings — Permission denied (os error 13)")).toBe(
+      "Не удалось открыть настройки — нет доступа",
+    );
+  });
+
+  it("translates glued messages piece by piece", () => {
+    expect(t("line endings normalized to lf · snapshot failed — not a snapshot")).toBe(
+      "Концы строк приведены к lf · Версия для истории не записалась — это не версия из истории",
+    );
+  });
+
+  it("never lets a number pattern claim ordinary words", () => {
+    expect(tc("menu", "new file")).toBe("Новый файл");
+    expect(t("my new file")).toBe("my new file");
+  });
+
+  it("takes a context key first", () => {
+    expect(tc("menu", "edit")).toBe("Правка");
+    expect(t("edit")).toBe("Разметка");
+    expect(tc("menu", "read")).toBe("Чтение");
+  });
+
+  it("translates month abbreviations in dates", () => {
+    expect(months("4 sep 2025")).toBe("4 сен 2025");
+  });
+
+  it("stays English when asked", () => {
+    setLanguage("en");
+    expect(t("save as…")).toBe("save as…");
+  });
+});
+
+describe("coverage", () => {
+  it("every command title has a translation", () => {
+    const missing = commands.map((c) => c.title).filter((title) => !hasTranslation(title));
+    expect(missing).toEqual([]);
+  });
+
+  it("every menu label has a translation", () => {
+    const missing: string[] = [];
+    const walk = (nodes: MenuNode[]) => {
+      for (const node of nodes) {
+        if (node.kind === "separator") continue;
+        // Heading levels are digits, recent files are file names.
+        if (
+          /^\d$/.test(node.label) ||
+          node.key.startsWith("recent-") ||
+          node.key.startsWith("lib-") ||
+          node.key.startsWith("reopen-")
+        ) {
+          continue;
+        }
+        if (!hasTranslation(`menu|${node.label}`) && !hasTranslation(node.label)) missing.push(node.label);
+        if (node.kind === "submenu") walk(node.items);
+      }
+    };
+    for (const section of menuModel()) {
+      if (!hasTranslation(`menu|${section.label}`)) missing.push(section.label);
+      walk(section.items);
+    }
+    expect(missing).toEqual([]);
+  });
+
+  /**
+   * Every literal the code hands to t()/tc(), and every literal message,
+   * label, title and dialog line the display points translate. A new
+   * upstream string shows up here instead of on the screen in English.
+   */
+  it("every literal the interface shows has a translation", () => {
+    const sources = Object.entries(
+      import.meta.glob<string>(["../**/*.ts", "../**/*.tsx", "!../**/*.test.*", "!../i18n/**"], {
+        query: "?raw",
+        import: "default",
+        eager: true,
+      }),
+    ).map(([, text]) => text);
+    expect(sources.length).toBeGreaterThan(80);
+
+    const patterns = [
+      /\bt\("([^"]+)"\)/g,
+      /setMessage\("([^"]+)"\)/g,
+      /setNote\("([^"]+)"\)/g,
+      /\b(?:label|title|text): "([^"]+)"/g,
+    ];
+    // Literals that are meant to stay as they are.
+    const keep = new Set(["B", "I", "S", "`", "‹›", "H1", "H2", "H3", "•", "1.", "☐", "»", "─", "∑", "==", "[[ ]]", "[^]", "2", "4", "crlf", "lf", "utf-8", "cp1251", "utf-16", "русский", "english", "a > b", "Plain"]);
+    const missing = new Set<string>();
+    for (const source of sources) {
+      for (const pattern of patterns) {
+        for (const match of source.matchAll(pattern)) {
+          const text = match[1]!;
+          if (keep.has(text) || !/[a-z]/.test(text)) continue;
+          if (!hasTranslation(text) && !hasTranslation(`menu|${text}`) && !hasTranslation(`choice|${text}`) && !hasTranslation(`btn|${text}`)) {
+            missing.add(text);
+          }
+        }
+      }
+    }
+    expect([...missing]).toEqual([]);
+
+    // Template literals: each `${…}` stands for a value the pattern keys
+    // carry as {} or {t}. Conditionals inside `${}` are not followed.
+    const templates = [
+      /\bt\(`([^`]+)`\)/g,
+      /setMessage\(`([^`]+)`\)/g,
+      /setNote\(`([^`]+)`\)/g,
+      /\b(?:title|text): `([^`]+)`/g,
+      /lines: \[`([^`]+)`/g,
+    ];
+    const missingTemplates = new Set<string>();
+    for (const source of sources) {
+      for (const pattern of templates) {
+        for (const match of source.matchAll(pattern)) {
+          const raw = match[1]!;
+          if (raw.includes("?") && raw.includes(":") && raw.includes("${")) continue;
+          const sample = raw.replace(/\$\{[^}]*\}/g, "7");
+          if (!/[a-z]{2}/.test(sample)) continue;
+          if (!hasTranslation(sample)) missingTemplates.add(raw);
+        }
+      }
+    }
+    expect([...missingTemplates]).toEqual([]);
+  });
+});
diff --git a/src/i18n/index.ts b/src/i18n/index.ts
new file mode 100644
index 0000000..faa3781
--- /dev/null
+++ b/src/i18n/index.ts
@@ -0,0 +1,180 @@
+// Fork: interface language (Plain RU).
+//
+// The upstream app writes every piece of microcopy in English, right where it
+// is used. Rather than touching each call site, the fork translates at the
+// places where text reaches the screen: the status bar, banners, dialogs, the
+// menu, the palette, the shortcut list, tooltips and the static JSX. The
+// logic keeps speaking English, so the upstream tests stay valid and a newer
+// upstream version can be merged with few conflicts.
+//
+// The dictionary is keyed by the English text. A key may hold placeholders:
+//   {}   a piece passed through as is (a file name)
+//   {n}  a number, digits with `,` or `.` (so `{n} files` never eats `new file`)
+//   {t}  a piece that is itself translated (an error message, a mode name)
+// The value refers to them as {1}, {2}… in order, or is a function of them.
+
+import { ru } from "./ru";
+
+export type Language = "ru" | "en";
+
+export const LANGUAGES: readonly Language[] = ["ru", "en"] as const;
+
+/** The fork ships Russian first; settings.json can say "en". */
+export const DEFAULT_LANGUAGE: Language = "ru";
+
+export type Translation = string | ((...parts: string[]) => string);
+
+let current: Language = "en";
+let pinned: Language | null = null;
+
+/**
+ * The upstream suite asserts English microcopy, so vitest.setup.ts pins the
+ * language the way it pins the platform; `null` hands it back to settings.
+ */
+export function setLanguageForTests(value: Language | null): void {
+  pinned = value;
+  current = value ?? current;
+}
+
+export function language(): Language {
+  return current;
+}
+
+/**
+ * Called once at startup with the value from settings.json, and again when
+ * the setting changes. Text already on screen follows on its next render;
+ * the settings screen says that a restart applies it everywhere.
+ */
+export function setLanguage(next: Language): void {
+  current = pinned ?? next;
+  if (typeof document !== "undefined") document.documentElement.lang = current;
+}
+
+interface Pattern {
+  re: RegExp;
+  /** How much fixed text the key has; more means more specific. */
+  literal: number;
+  nested: boolean[];
+  value: Translation;
+}
+
+let exact: Map<string, Translation> | null = null;
+let patterns: Pattern[] = [];
+
+function escape(text: string): string {
+  return text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
+
+function compile(): void {
+  exact = new Map();
+  patterns = [];
+  for (const [key, value] of Object.entries(ru)) {
+    if (!/\{[tn]?\}/.test(key)) {
+      exact.set(key, value);
+      continue;
+    }
+    const nested: boolean[] = [];
+    const source = key
+      .split(/(\{[tn]?\})/)
+      .map((piece) => {
+        if (piece === "{n}") {
+          nested.push(false);
+          return "(\\d[\\d,.]*)";
+        }
+        if (piece === "{}" || piece === "{t}") {
+          nested.push(piece === "{t}");
+          // A placeholder never swallows ` · `: that is where the app glues
+          // two messages together, and each half is translated on its own.
+          return "((?:(?! · )[\\s\\S])*?)";
+        }
+        return escape(piece);
+      })
+      .join("");
+    patterns.push({
+      re: new RegExp(`^${source}$`),
+      literal: key.replace(/\{[tn]?\}/g, "").length,
+      nested,
+      value,
+    });
+  }
+  // Longer literal text first, so "couldn't open settings — {t}" wins over
+  // "couldn't open {} — {t}".
+  patterns.sort((a, b) => b.literal - a.literal);
+}
+
+function fill(value: Translation, parts: string[]): string {
+  if (typeof value === "function") return value(...parts);
+  return value.replace(/\{(\d)\}/g, (_, n: string) => parts[Number(n) - 1] ?? "");
+}
+
+/**
+ * The text in the interface language. Unknown text comes back unchanged, so
+ * a string the dictionary has not caught up with stays readable in English.
+ */
+export function t(text: string): string;
+export function t(text: string | null | undefined): string | null | undefined;
+export function t(text: string | null | undefined): string | null | undefined {
+  if (current === "en" || !text) return text;
+  if (!exact) compile();
+  const found = exact!.get(text);
+  if (found !== undefined) return fill(found, []);
+  for (const pattern of patterns) {
+    const match = pattern.re.exec(text);
+    if (!match) continue;
+    const parts = match.slice(1).map((part, index) => (pattern.nested[index] ? inner(part) : part));
+    return fill(pattern.value, parts);
+  }
+  // Messages the app glues together — `line endings normalized · snapshot
+  // failed — …` — are translated piece by piece.
+  if (text.includes(" · ")) {
+    const pieces = text.split(" · ");
+    const translated = pieces.map((piece) => t(piece));
+    if (translated.some((piece, index) => piece !== pieces[index])) return translated.join(" · ");
+  }
+  return text;
+}
+
+/**
+ * A translated piece inside a sentence: `Не удалось сохранить — файл
+ * изменился на диске`, not `— Файл`. Abbreviations (`UTF-8`) keep their case.
+ */
+function inner(part: string): string {
+  const translated = t(part);
+  if (translated === part) return part;
+  return /^\p{Lu}\p{Ll}/u.test(translated) ? translated[0]!.toLowerCase() + translated.slice(1) : translated;
+}
+
+/** For tests and for the coverage check: is there a translation at all? */
+function hasExact(text: string): boolean {
+  if (!exact) compile();
+  return exact!.has(text);
+}
+
+export function hasTranslation(text: string): boolean {
+  if (!exact) compile();
+  if (exact!.has(text)) return true;
+  return patterns.some((pattern) => pattern.re.test(text));
+}
+
+export { plural } from "./plural";
+
+/**
+ * The same English word can need two Russian ones: the `edit` menu is
+ * «Правка», the `edit` mode is «Разметка». A context key `menu|edit` wins
+ * when the dictionary has one.
+ */
+export function tc(context: string, text: string): string {
+  if (current === "en") return text;
+  // Context keys are always exact: a pattern such as `{} file` must not
+  // claim `menu|new file`.
+  const key = `${context}|${text}`;
+  return hasExact(key) ? t(key) : t(text);
+}
+
+const MONTH_WORDS = /\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/g;
+
+/** `4 sep 2025` -> `4 сен 2025`, for dates formatted by upstream helpers. */
+export function months(text: string): string {
+  if (current === "en") return text;
+  return text.replace(MONTH_WORDS, (month) => tc("month", month));
+}
