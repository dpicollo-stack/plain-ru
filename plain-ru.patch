 /* -------------------------------------------- the macOS application menu */
 
+/// Fork: `appearance.language` from settings.json, read once when the menu is
+/// built. The front end owns the file; this only reads it. A missing file, a
+/// broken one or an unknown value means the fork's default, Russian.
+pub fn menu_language(data: &Path) -> String {
+    std::fs::read_to_string(data.join("settings.json"))
+        .ok()
+        .and_then(|text| serde_json::from_str::<serde_json::Value>(&text).ok())
+        .and_then(|json| {
+            json.get("appearance")?
+                .get("language")?
+                .as_str()
+                .map(str::to_owned)
+        })
+        .filter(|language| language == "ru" || language == "en")
+        .unwrap_or_else(|| "ru".to_owned())
+}
+
+/// Fork: the native menu's words. `None` leaves an item to macOS's default
+/// (English) title.
+#[derive(Debug, PartialEq)]
+pub struct MenuWords {
+    pub quit: &'static str,
+    pub about: Option<&'static str>,
+    pub services: Option<&'static str>,
