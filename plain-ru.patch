+++ b/src/i18n/ru.ts
@@ -0,0 +1,539 @@
+// Fork: the Russian interface (Plain RU).
+//
+// Keys are the upstream English text, exactly as the code writes it; see
+// index.ts for the {} / {t} placeholders. Microcopy follows macOS Russian
+// conventions: sentence case, «…» for anything that opens a dialog.
+//
+// Context keys (`menu|edit`, `rail|open`…) exist where one English word needs
+// two Russian ones; tc() in index.ts looks them up first.
+
